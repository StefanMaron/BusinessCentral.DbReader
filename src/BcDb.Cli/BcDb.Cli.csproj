<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bcdb</AssemblyName>
    <RootNamespace>BusinessCentral.DbReader</RootNamespace>
    <Version>0.2.0</Version>
    <!--
      Also shipped as a .NET tool: `dotnet tool install` with the -g flag. SDK 10 RID-specific tool
      packages carry a real Native AOT binary per platform, so the tool install is the same
      57 ms binary as the release download rather than the 174 ms JIT one. `any` is the
      CoreCLR fallback for platforms with no AOT build; `bcdb` reports which one is
      running in its version banner. Each AOT package must be packed on its matching OS: `dotnet pack -r <rid>`.
    -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bcdb</ToolCommandName>
    <PackageId>bcdb</PackageId>
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <Description>Reads Business Central data directly out of SQL Server native backups (.bak) and BC cloud exports (.bacpac), with no SQL Server, no restore or import, and no service tier. Lists tables, decodes rows including page compression and off-page LOBs, resolves AL field names from SymbolReference.json, and answers many reads over one open file in serve mode.</Description>
    <Authors>Stefan Maron</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/StefanMaron/BusinessCentral.DbReader</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StefanMaron/BusinessCentral.DbReader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>business-central;dynamics-365;sql-server;backup;bak;bacpac;cli;dotnet-tool</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Not invariant, and it cannot be: Microsoft.Data.SqlClient refuses to initialise under
      Globalization Invariant Mode ("Globalization Invariant Mode is not supported.", thrown
      before a connection is even attempted), so `bcdb restore` could not open a connection
      while this was true. The cost is that the Linux build now needs ICU present on the
      host, the way any other non-invariant .NET application does; Windows uses NLS and
      macOS ships ICU, so only Linux can be missing it. Nothing in the reading path depends
      on a culture — every decoder formats with InvariantCulture explicitly — so this
      changes what the binary links against, not what it answers.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      Publish native: a one-shot `bcdb read` is a short process, and on a warm file most
      of its wall clock was runtime startup and JIT rather than work. Measured on the BC
      28.1 demo backup, one-shot read of G/L Account (median of 8 warm / 5 cold runs):

                   startup floor   warm      cold
        JIT             30 ms     193.5 ms  228 ms
        ReadyToRun      30 ms     121.0 ms  159 ms
        NativeAOT        4 ms      51.0 ms   88 ms

      `dotnet build` is unaffected and still produces the ordinary JIT build that the
      tests and verify.sh run against; this only governs `dotnet publish -r <rid>`.
      Every CLI surface was compared JIT vs AOT for identical output: tables, read,
      companies, check, describe with symbols, merged table extensions, serve, and
      both containers.
    -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BcDb.Core/BcDb.Core.csproj" />
    <!--
      `bcdb restore` writes rows into a database that already exists (a BC container), and
      SqlBulkCopy is the only way to do that at the volumes a BC database comes in. The
      dependency lives here and not in BcDb.Core on purpose: the library's promise is
      reading a file with no SQL Server anywhere, and a consumer that only wants to read
      should not acquire a database client to do it.

      Publishing this project Native AOT emits IL2104 ("Microsoft.Data.SqlClient produced
      trim warnings") — the package is not fully trim-annotated. The publish succeeds and
      the resulting binary connects and bulk-copies; the warning is left visible rather
      than suppressed, because it is the honest state of the dependency.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Managed networking on Windows too. On Windows the client otherwise talks to the
      server through a native Microsoft.Data.SqlClient.SNI.dll, which the publish copies
      next to bcdb.exe rather than into it — and the release asset is one file, so a
      downloaded bcdb.exe would have found no SNI at the moment somebody ran `restore`.
      The managed implementation is the same one every non-Windows platform already uses.
      Not exercised on Windows from this machine; the win-x64 leg of the release workflow
      is where that shows.
    -->
    <RuntimeHostConfigurationOption Include="Switch.Microsoft.Data.SqlClient.UseManagedNetworkingOnWindows"
                                    Value="true" Trim="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
